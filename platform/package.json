{
  "name": "nova-casino-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "games/slots-classic",
    "games/slots-studio",
    "games/slots-premium",
    "games/crash",
    "games/plinko",
    "games/roulette",
    "games/keno",
    "games/dice",
    "games/limbo",
    "games/wheel",
    "games/mines",
    "games/hilo",
    "games/sicbo",
    "games/baccarat",
    "games/roulette-us",
    "games/blackjack",
    "games/holdem",
    "games/videopoker",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,LOBBY \"npm start -w @nova/api\" \"npm run dev -w @nova/lobby\"",
    "generate:brand-art": "node scripts/generate-brand-art.mjs",
    "calibrate:slots": "node scripts/calibrate-slot-math.mjs && node scripts/sync-slot-catalog.mjs",
    "qa:rtp": "node scripts/qa/rtp-sim.mjs",
    "sync:game-sdk": "node scripts/sync-game-sdk.mjs",
    "build:games": "npm run sync:game-sdk && node scripts/build-games.mjs",
    "stage:games": "node scripts/stage-games.mjs",
    "build": "npm run build:games && npm run stage:games && npm run build -w @nova/lobby",
    "build:brands": "npm run generate:brand-art && npm run build:games && npm run stage:games && npm run build:brands -w @nova/lobby",
    "verify:brands": "node scripts/brands/verify.mjs",
    "preview:all": "node scripts/preview-all.mjs",
    "qa:games": "node scripts/qa/all-games.mjs",
    "qa:premium": "node scripts/qa/premium-slots.mjs",
    "serve:brand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/brands/serve.ps1",
    "test": "npm test -w @nova/lobby && npm test -w @nova/game-sdk && npm test -w @nova/api && npm test -w @nova/slots-studio && npm test -w @nova/slots-premium && npm test -w @nova/crash && npm test -w @nova/plinko && npm test -w @nova/roulette && npm test -w @nova/keno && npm test -w @nova/dice && npm test -w @nova/limbo && npm test -w @nova/wheel && npm test -w @nova/mines && npm test -w @nova/hilo && npm test -w @nova/sicbo && npm test -w @nova/baccarat && npm test -w @nova/roulette-us && npm test -w @nova/blackjack && npm test -w @nova/holdem && npm test -w @nova/videopoker",
    "audit:prod": "npm audit --omit=dev",
    "infra:config": "docker compose config --quiet",
    "infra:up": "docker compose up -d --build --wait",
    "infra:down": "docker compose down",
    "stage:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-local.ps1",
    "qa:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-qa.ps1",
    "sync:slot-catalog": "node scripts/sync-slot-catalog.mjs",
    "generate:covers": "node scripts/generate-cover-art.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "native:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/start.ps1",
    "native:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/stop.ps1",
    "native:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/status.ps1",
    "native:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/backup.ps1",
    "native:backup:drill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/backup-drill.ps1",
    "native:autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/install-autostart.ps1",
    "native:autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native/uninstall-autostart.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.58.2",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
