# Local production-like runtime without Docker. Keep .env.native private.
POSTGRES_DB=arcade
POSTGRES_USER=arcade
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARACTERS
ANALYTICS_ADMIN_KEY=CHANGE_ME_32_RANDOM_CHARACTERS
NATIVE_PG_PORT=55432
PORT=8787
CONTROL_PORT=8788
LOBBY_PORT=8080
GAMES_PORT=8081
SESSION_TTL_HOURS=168
LOG_MAX_BYTES=10485760
LOG_RETENTION_FILES=5
# Optional public build-time origins. Leave blank for local demonstration.
PUBLIC_API_URL=
PUBLIC_GAME_ORIGIN=
# Comma-separated HTTPS lobby origins when exposed through a reverse proxy.
ALLOWED_ORIGINS=
TRUST_PROXY=false
# Production default is 300 requests/minute/IP. Raise only for controlled QA.
GLOBAL_RATE_LIMIT=300
