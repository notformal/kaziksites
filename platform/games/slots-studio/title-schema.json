{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-arcade.local/schemas/slot-title.json",
  "title": "Original slot title manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","id","title","theme","symbols","paytable","reels","rows","lines","betOptions","volatility","mathProfile"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type":"string","pattern":"^slot-original-(00[1-9]|0[1-9][0-9]|1[01][0-9]|12[0-7])$"},
    "title": {"type":"string","minLength":4,"maxLength":60},
    "theme": {"type":"object","additionalProperties":false,"required":["accent","background","panel","text"],"properties":{"accent":{"$ref":"#/$defs/color"},"background":{"$ref":"#/$defs/color"},"panel":{"$ref":"#/$defs/color"},"text":{"$ref":"#/$defs/color"}}},
    "symbols": {"type":"array","minItems":8,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["id","label","color","kind"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9-]*$"},"label":{"type":"string","minLength":1},"color":{"$ref":"#/$defs/color"},"kind":{"enum":["regular","wild","scatter"]}}}},
    "paytable": {"type":"object","minProperties":8,"additionalProperties":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"number","minimum":0}}},
    "reels":{"const":5}, "rows":{"const":3}, "lines":{"type":"integer","minimum":1,"maximum":50},
    "betOptions":{"type":"array","minItems":3,"uniqueItems":true,"items":{"type":"integer","minimum":1}},
    "volatility":{"enum":["low","medium","high"]},
    "mathProfile":{"type":"object","additionalProperties":false,"required":["version","hitRate","weights","bonus"],"properties":{"version":{"const":"1.0.0"},"hitRate":{"type":"number","exclusiveMinimum":0,"exclusiveMaximum":1},"weights":{"type":"object","minProperties":8,"additionalProperties":{"type":"integer","minimum":1}},"bonus":{"type":"object","additionalProperties":false,"required":["type","triggerSymbol","triggerCount","freeSpins","multiplier"],"properties":{"type":{"enum":["free-spins","multiplier","respin"]},"triggerSymbol":{"type":"string"},"triggerCount":{"type":"integer","minimum":3,"maximum":5},"freeSpins":{"type":"integer","minimum":0,"maximum":25},"multiplier":{"type":"number","minimum":1,"maximum":10}}}}}
  },
  "$defs":{"color":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"}}
}
