# Endpoint that receives consent-gated, anonymous product analytics.
# Leave empty to disable analytics delivery entirely.
VITE_ANALYTICS_ENDPOINT=

# Public origin of the brand site being built, no trailing slash
# (e.g. https://aurora.example.com).
#
# When set, the build emits absolute canonical / og:url tags plus sitemap.xml,
# and robots.txt points at that sitemap. When unset those are omitted rather
# than pointing at a placeholder domain — the build stays valid either way.
#
# Each brand deploys as its own site, so set this per deployment
# (Netlify: Site settings -> Environment variables).
SITE_URL=
